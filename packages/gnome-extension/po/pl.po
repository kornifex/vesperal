#: packages/gnome-extension/src/prefs.ts:60
msgid "The duration shown in the top bar"
msgstr "Na górnym pasku"

#: packages/gnome-extension/src/prefs.ts:69
msgid "Until the next sunrise or sunset"
msgstr "Do najbliższego wschodu lub zachodu słońca"

#: packages/gnome-extension/src/prefs.ts:70
msgid "Since the last sunrise or sunset"
msgstr "Od ostatniego wschodu lub zachodu słońca"

#: packages/gnome-extension/src/prefs.ts:79
msgid "Sun arc"
msgstr "Łuk słońca"

#: packages/gnome-extension/src/prefs.ts:80
msgid "Its side of the Reading in the top bar"
msgstr "Po której stronie czasu, na górnym pasku"

#: packages/gnome-extension/src/prefs.ts:94
msgid "Left"
msgstr "Po lewej"

#: packages/gnome-extension/src/prefs.ts:95
msgid "Right"
msgstr "Po prawej"

#: packages/gnome-extension/src/prefs.ts:104
msgid "Twilight"
msgstr "Świt i zmierzch"

#: packages/gnome-extension/src/prefs.ts:105
msgid "When Dawn and Dusk fall, as shown in the menu"
msgstr "Ich godziny, wyświetlane w menu"

#: packages/gnome-extension/src/prefs.ts:114
msgid "Civil"
msgstr "Cywilny"

#: packages/gnome-extension/src/prefs.ts:114
msgid "Sun 6° below the horizon"
msgstr "Słońce 6° pod horyzontem"

#: packages/gnome-extension/src/prefs.ts:115
msgid "Nautical"
msgstr "Żeglarski"

#: packages/gnome-extension/src/prefs.ts:115
msgid "Sun 12° below the horizon"
msgstr "Słońce 12° pod horyzontem"

#: packages/gnome-extension/src/prefs.ts:116
msgid "Astronomical"
msgstr "Astronomiczny"

#: packages/gnome-extension/src/prefs.ts:116
msgid "Sun 18° below the horizon"
msgstr "Słońce 18° pod horyzontem"

#: packages/gnome-extension/src/prefs.ts:144
msgid "Automatic"
msgstr "Automatyczne"

#: packages/gnome-extension/src/prefs.ts:145
msgid "Manual"
msgstr "Ręczne"

#: packages/gnome-extension/src/prefs.ts:150
msgid "Search for a city"
msgstr "Wyszukaj miasto"

#: packages/gnome-extension/src/prefs.ts:164
msgid "Coordinates"
msgstr "Współrzędne"

#: packages/gnome-extension/src/prefs.ts:165
msgid "For any point on Earth, in decimal degrees"
msgstr "Dla dowolnego punktu na Ziemi, w stopniach dziesiętnych"

#: packages/gnome-extension/src/prefs.ts:169
msgid "Latitude (north positive)"
msgstr "Szerokość geograficzna (dodatnia na północ)"

#: packages/gnome-extension/src/prefs.ts:174
msgid "Longitude (east positive)"
msgstr "Długość geograficzna (dodatnia na wschód)"

#: packages/gnome-extension/src/prefs.ts:184
msgid "From the system's location services"
msgstr "Z usług położenia systemu"

#: packages/gnome-extension/src/prefs.ts:185
msgid "Location services are off"
msgstr "Usługi położenia są wyłączone"

#: packages/gnome-extension/src/prefs.ts:191
msgid "No location set"
msgstr "Nie ustawiono położenia"

#: packages/gnome-extension/src/prefs.ts:230
msgid "Latitude must be between −90 and 90"
msgstr "Szerokość geograficzna musi mieścić się między −90 a 90"

#: packages/gnome-extension/src/prefs.ts:233
msgid "Longitude must be between −180 and 180"
msgstr "Długość geograficzna musi mieścić się między −180 a 180"
