#. Translators: a notification, e.g. "Sunset in 30 min".
#: packages/core/src/presentation.ts:160
msgid "{event} in {duration}"
msgstr "{event} tra {duration}"

#. Translators: a notification at the moment of an event, e.g. "Sunset now".
#: packages/core/src/presentation.ts:165
msgid "{event} now"
msgstr "{event} ora"

#: packages/core/src/presentation.ts:173
msgid "Dawn"
msgstr "Alba"

#: packages/core/src/presentation.ts:174
msgid "Sunrise"
msgstr "Sorgere del sole"

#: packages/core/src/presentation.ts:175
msgid "Sunset"
msgstr "Tramonto"

#: packages/core/src/presentation.ts:176
msgid "Dusk"
msgstr "Crepuscolo"

#: packages/core/src/presentation.ts:183
#: packages/gnome-extension/src/prefs.ts:483
msgid "Location unknown"
msgstr "Posizione sconosciuta"

#: packages/core/src/presentation.ts:184
msgid "Set a location manually…"
msgstr "Imposta una posizione manualmente…"

#. Translators: shown in the top bar instead of the Reading when something went wrong.
#: packages/core/src/presentation.ts:192
msgid "Error"
msgstr "Errore"

#. Translators: both Readings in the top bar, e.g. "6h 10m / 7h 50m"; the Elapsed time
#. first, as on a video player.
#: packages/core/src/presentation.ts:218
msgid "{elapsed} / {remaining}"
msgstr "{elapsed} / {remaining}"

#: packages/core/src/presentation.ts:225
msgid "Polar day"
msgstr "Giorno polare"

#: packages/core/src/presentation.ts:227
msgid "Polar night"
msgstr "Notte polare"

#. Translators: shown in the top bar instead of the Reading while, counting from Dawn to
#. Dusk, the Sun does not get far enough below the horizon for Dusk for over 24 hours.
#: packages/core/src/presentation.ts:231
msgid "No dark night"
msgstr "Nessuna notte buia"

#: packages/core/src/presentation.ts:259 packages/core/src/presentation.ts:274
#: packages/core/src/yearPresentation.ts:55
msgid "Day length"
msgstr "Durata del giorno"

#: packages/core/src/presentation.ts:263
msgid "Night length"
msgstr "Durata della notte"

#: packages/core/src/presentation.ts:301
#: packages/gnome-extension/src/prefs.ts:109
msgid "Remaining time"
msgstr "Tempo rimanente"

#: packages/core/src/presentation.ts:305
#: packages/gnome-extension/src/prefs.ts:110
msgid "Elapsed time"
msgstr "Tempo trascorso"

#: packages/core/src/presentation.ts:342
msgid "Automatic location"
msgstr "Posizione automatica"

#: packages/core/src/presentation.ts:344
msgid "Manual location"
msgstr "Posizione manuale"

#: packages/core/src/presentation.ts:346
msgid "Last known location"
msgstr "Ultima posizione nota"

#: packages/core/src/presentation.ts:362
msgid "{degrees}° N"
msgstr "{degrees}° N"

#: packages/core/src/presentation.ts:362
msgid "{degrees}° S"
msgstr "{degrees}° S"

#: packages/core/src/presentation.ts:366
msgid "{degrees}° E"
msgstr "{degrees}° E"

#: packages/core/src/presentation.ts:366
msgid "{degrees}° W"
msgstr "{degrees}° O"

#. Translators: a Civil time on the day before today, e.g. "yesterday at 21:58".
#: packages/core/src/presentation.ts:395
msgid "yesterday at {time}"
msgstr "ieri alle {time}"

#. Translators: a Civil time on the day after today, e.g. "tomorrow at 05:47".
#: packages/core/src/presentation.ts:398
msgid "tomorrow at {time}"
msgstr "domani alle {time}"

#. Translators: a Civil time further away than yesterday or tomorrow, e.g. "Thu 18 Jun at
#. 21:58"; {date} follows the locale of dates and times.
#: packages/core/src/presentation.ts:408
msgid "{date} at {time}"
msgstr "{date} alle {time}"

#. Translators: a duration over 24 hours, e.g. "68d 23h", for a Polar day or Polar night.
#: packages/core/src/presentation.ts:416
msgid "{days}d {hours}h"
msgstr "{days} g {hours} h"

#. Translators: a duration under one hour, e.g. "42 min".
#: packages/core/src/presentation.ts:423
msgid "{minutes} min"
msgstr "{minutes} min"

#. Translators: a duration over one hour, e.g. "3h 05m"; {minutes} always has two digits.
#: packages/core/src/presentation.ts:426
msgid "{hours}h {minutes}m"
msgstr "{hours} h {minutes} min"

#. Translators: how much longer or shorter a Day is than the Day before, under a
#. minute, after an arrow: e.g. "↑45s".
#: packages/core/src/presentation.ts:457
msgid "{seconds}s"
msgstr "{seconds} s"

#. Translators: how much longer or shorter a Day is than the Day before, after an
#. arrow: e.g. "↓3m".
#: packages/core/src/presentation.ts:460
msgid "{minutes}m"
msgstr "{minutes} min"

#: packages/core/src/yearPresentation.ts:100
msgid "today"
msgstr "oggi"

#: packages/core/src/yearPresentation.ts:102
msgid "tomorrow"
msgstr "domani"

#. Translators: how far away a date is, in days; never fewer than 2.
#: packages/core/src/yearPresentation.ts:104
msgid "in {days} day"
msgid_plural "in {days} days"
msgstr[0] "tra {days} giorno"
msgstr[1] "tra {days} giorni"

#. Translators: a date to come, then how far away it is, e.g. "Monday 21 December, in 65 days";
#. {date} follows the locale of dates and times.
#: packages/core/src/yearPresentation.ts:107
msgid "{date}, {relative}"
msgstr "{date}, {relative}"

#: packages/core/src/yearPresentation.ts:114
msgid "March equinox"
msgstr "Equinozio di marzo"

#: packages/core/src/yearPresentation.ts:116
msgid "June solstice"
msgstr "Solstizio di giugno"

#: packages/core/src/yearPresentation.ts:118
msgid "September equinox"
msgstr "Equinozio di settembre"

#: packages/core/src/yearPresentation.ts:120
msgid "December solstice"
msgstr "Solstizio di dicembre"

