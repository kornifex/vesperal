#: packages/gnome-extension/src/prefs.ts:164
msgid "Coordinates"
msgstr "Coordinate"

#: packages/gnome-extension/src/prefs.ts:165
msgid "For any point on Earth, in decimal degrees"
msgstr "Per qualsiasi punto della Terra, in gradi decimali"

#: packages/gnome-extension/src/prefs.ts:169
msgid "Latitude (north positive)"
msgstr "Latitudine (positiva a nord)"

#: packages/gnome-extension/src/prefs.ts:174
