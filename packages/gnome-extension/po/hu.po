#: packages/core/src/presentation.ts:88
msgid "Location unknown"
msgstr "Ismeretlen hely"

#: packages/core/src/presentation.ts:89
msgid "Set a location manually…"
msgstr "Hely kézi megadása…"

#. Translators: shown in the top bar instead of the Reading when something went wrong.
#: packages/core/src/presentation.ts:97
msgid "Error"
msgstr "Hiba"

#: packages/core/src/presentation.ts:106
msgid "Polar day"
msgstr "Sarki nappal"

#: packages/core/src/presentation.ts:106
msgid "Polar night"
msgstr "Sarki éjszaka"

#: packages/core/src/presentation.ts:118
msgid "Dawn"
msgstr "Hajnal"

#: packages/core/src/presentation.ts:119
msgid "Sunrise"
msgstr "Napkelte"

#: packages/core/src/presentation.ts:120
msgid "Sunset"
msgstr "Napnyugta"

#: packages/core/src/presentation.ts:121
msgid "Dusk"
msgstr "Alkony"

#: packages/core/src/presentation.ts:129 packages/core/src/presentation.ts:140
msgid "Day length"
msgstr "Nappal hossza"

#: packages/core/src/presentation.ts:129
msgid "Night length"
msgstr "Éjszaka hossza"

#: packages/core/src/presentation.ts:166
#: packages/gnome-extension/src/prefs.ts:69
msgid "Remaining time"
msgstr "Hátralévő idő"

#: packages/core/src/presentation.ts:172
#: packages/gnome-extension/src/prefs.ts:70
msgid "Elapsed time"
msgstr "Eltelt idő"

#: packages/core/src/presentation.ts:189
msgid "Automatic location"
msgstr "Automatikus hely"

#: packages/core/src/presentation.ts:191
msgid "Manual location"
msgstr "Kézi hely"

#: packages/core/src/presentation.ts:193
msgid "Last known location"
msgstr "Utolsó ismert hely"

#: packages/core/src/presentation.ts:206
msgid "{degrees}° N"
msgstr "{degrees}° É"

#: packages/core/src/presentation.ts:206
msgid "{degrees}° S"
msgstr "{degrees}° D"

#: packages/core/src/presentation.ts:210
msgid "{degrees}° E"
msgstr "{degrees}° K"

#: packages/core/src/presentation.ts:210
msgid "{degrees}° W"
msgstr "{degrees}° Ny"

#. Translators: a Civil time on the day before today, e.g. "yesterday at 21:58".
#: packages/core/src/presentation.ts:231
msgid "yesterday at {time}"
msgstr "tegnap {time}"

#. Translators: a Civil time on the day after today, e.g. "tomorrow at 05:47".
#: packages/core/src/presentation.ts:234
msgid "tomorrow at {time}"
msgstr "holnap {time}"

#. Translators: a Civil time further away than yesterday or tomorrow, e.g. "Thu 18 Jun at
#. 21:58"; {date} follows the locale of dates and times.
#: packages/core/src/presentation.ts:244
msgid "{date} at {time}"
msgstr "{date} {time}"

#. Translators: a duration over 24 hours, e.g. "68d 23h", for a Polar day or Polar night.
#: packages/core/src/presentation.ts:265
msgid "{days}d {hours}h"
msgstr "{days} n {hours} ó"

#. Translators: a duration under one hour, e.g. "42 min".
#: packages/core/src/presentation.ts:272
msgid "{minutes} min"
msgstr "{minutes} perc"

#. Translators: a duration over one hour, e.g. "3h 05m"; {minutes} always has two digits.
#: packages/core/src/presentation.ts:275
msgid "{hours}h {minutes}m"
msgstr "{hours} ó {minutes} p"

#: packages/gnome-extension/src/extension.ts:44
msgid "Preferences"
msgstr "Beállítások"

#. Translators: a page of the preferences, about what the top bar and the menu show.
#: packages/gnome-extension/src/prefs.ts:33
msgid "Display"
msgstr "Megjelenítés"

#: packages/gnome-extension/src/prefs.ts:37
#: packages/gnome-extension/src/prefs.ts:132
msgid "Location"
msgstr "Hely"

#: packages/gnome-extension/src/prefs.ts:59
msgid "Reading"
msgstr "Megjelenített időtartam"

#: packages/gnome-extension/src/prefs.ts:60
msgid "The duration shown in the top bar"
msgstr "A felső sávban"

#: packages/gnome-extension/src/prefs.ts:69
msgid "Until the next sunrise or sunset"
msgstr "A következő napkeltéig vagy napnyugtáig"

#: packages/gnome-extension/src/prefs.ts:70
msgid "Since the last sunrise or sunset"
msgstr "Az utolsó napkelte vagy napnyugta óta"

#: packages/gnome-extension/src/prefs.ts:79
msgid "Sun arc"
msgstr "Napív"

#: packages/gnome-extension/src/prefs.ts:80
msgid "Its side of the Reading in the top bar"
msgstr "Az időtartam melyik oldalán, a felső sávban"

#: packages/gnome-extension/src/prefs.ts:94
msgid "Left"
msgstr "Balra"

#: packages/gnome-extension/src/prefs.ts:95
msgid "Right"
msgstr "Jobbra"

#: packages/gnome-extension/src/prefs.ts:104
msgid "Twilight"
msgstr "Hajnal és alkony"

#: packages/gnome-extension/src/prefs.ts:105
msgid "When Dawn and Dusk fall, as shown in the menu"
msgstr "Időpontjaik a menüben"

#: packages/gnome-extension/src/prefs.ts:114
msgid "Civil"
msgstr "Polgári"

#: packages/gnome-extension/src/prefs.ts:114
msgid "Sun 6° below the horizon"
msgstr "A Nap 6 fokkal a horizont alatt"

#: packages/gnome-extension/src/prefs.ts:115
msgid "Nautical"
msgstr "Nautikai"

#: packages/gnome-extension/src/prefs.ts:115
msgid "Sun 12° below the horizon"
msgstr "A Nap 12 fokkal a horizont alatt"

#: packages/gnome-extension/src/prefs.ts:116
msgid "Astronomical"
msgstr "Csillagászati"

#: packages/gnome-extension/src/prefs.ts:116
msgid "Sun 18° below the horizon"
msgstr "A Nap 18 fokkal a horizont alatt"

#: packages/gnome-extension/src/prefs.ts:144
msgid "Automatic"
msgstr "Automatikus"

#: packages/gnome-extension/src/prefs.ts:145
msgid "Manual"
msgstr "Kézi"

#: packages/gnome-extension/src/prefs.ts:150
msgid "Search for a city"
msgstr "Város keresése"

#: packages/gnome-extension/src/prefs.ts:164
msgid "Coordinates"
msgstr "Koordináták"

#: packages/gnome-extension/src/prefs.ts:165
msgid "For any point on Earth, in decimal degrees"
msgstr "A Föld bármely pontjához, tizedes fokban"

#: packages/gnome-extension/src/prefs.ts:169
msgid "Latitude (north positive)"
msgstr "Szélesség (észak pozitív)"

#: packages/gnome-extension/src/prefs.ts:174
msgid "Longitude (east positive)"
msgstr "Hosszúság (kelet pozitív)"

#: packages/gnome-extension/src/prefs.ts:184
msgid "From the system's location services"
msgstr "A rendszer helymeghatározó szolgáltatásaiból"

#: packages/gnome-extension/src/prefs.ts:185
msgid "Location services are off"
msgstr "A helymeghatározó szolgáltatások ki vannak kapcsolva"

#: packages/gnome-extension/src/prefs.ts:191
msgid "No location set"
msgstr "Nincs megadva hely"

#: packages/gnome-extension/src/prefs.ts:230
msgid "Latitude must be between −90 and 90"
msgstr "A szélességnek −90 és 90 között kell lennie"

#: packages/gnome-extension/src/prefs.ts:233
msgid "Longitude must be between −180 and 180"
msgstr "A hosszúságnak −180 és 180 között kell lennie"
