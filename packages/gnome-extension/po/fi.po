#: packages/core/src/presentation.ts:107
msgid "Error"
msgstr "Virhe"

#: packages/core/src/presentation.ts:116
msgid "Polar day"
msgstr "Napapäivä"

#: packages/core/src/presentation.ts:116
msgid "Polar night"
msgstr "Kaamos"

