#: packages/core/src/presentation.ts:282
#: packages/gnome-extension/src/prefs.ts:110
msgid "Elapsed time"
msgstr "Kulunut aika"

#: packages/core/src/presentation.ts:304
msgid "Automatic location"
msgstr "Automaattinen sijainti"

#: packages/core/src/presentation.ts:306
msgid "Manual location"
