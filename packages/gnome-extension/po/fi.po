#: packages/core/src/presentation.ts:205
msgid "Polar night"
msgstr "Kaamos"

#. Translators: shown in the top bar instead of the Reading while, counting from Dawn to
#. Dusk, the Sun does not get far enough below the horizon for Dusk for over 24 hours.
#: packages/core/src/presentation.ts:209
msgid "No dark night"
msgstr "Ei pimeää yötä"

#: packages/core/src/presentation.ts:235 packages/core/src/presentation.ts:250
#: packages/core/src/yearPresentation.ts:54
