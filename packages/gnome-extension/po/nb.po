#: packages/core/src/presentation.ts:105
msgid "Location unknown"
msgstr "Ukjent posisjon"

#: packages/core/src/presentation.ts:106
msgid "Set a location manually…"
msgstr "Angi en posisjon manuelt…"

#. Translators: shown in the top bar instead of the Reading when something went wrong.
#: packages/core/src/presentation.ts:114
msgid "Error"
msgstr "Feil"

#: packages/core/src/presentation.ts:123
msgid "Polar day"
msgstr "Polardag"

#: packages/core/src/presentation.ts:123
msgid "Polar night"
msgstr "Polarnatt"

#: packages/core/src/presentation.ts:135
msgid "Dawn"
msgstr "Daggry"

#: packages/core/src/presentation.ts:136
msgid "Sunrise"
msgstr "Soloppgang"

#: packages/core/src/presentation.ts:137
msgid "Sunset"
msgstr "Solnedgang"

#: packages/core/src/presentation.ts:138
msgid "Dusk"
msgstr "Skumring"

#: packages/core/src/presentation.ts:146 packages/core/src/presentation.ts:158
msgid "Day length"
msgstr "Daglengde"

#: packages/core/src/presentation.ts:146
msgid "Night length"
msgstr "Nattlengde"

#: packages/core/src/presentation.ts:186
#: packages/gnome-extension/src/prefs.ts:82
msgid "Remaining time"
msgstr "Gjenstående tid"

#: packages/core/src/presentation.ts:192
#: packages/gnome-extension/src/prefs.ts:83
msgid "Elapsed time"
msgstr "Forløpt tid"

#: packages/core/src/presentation.ts:209
msgid "Automatic location"
msgstr "Automatisk posisjon"

#: packages/core/src/presentation.ts:211
msgid "Manual location"
msgstr "Manuell posisjon"

#: packages/core/src/presentation.ts:213
msgid "Last known location"
msgstr "Sist kjente posisjon"

#: packages/core/src/presentation.ts:226
msgid "{degrees}° N"
msgstr "{degrees}° N"

#: packages/core/src/presentation.ts:226
msgid "{degrees}° S"
msgstr "{degrees}° S"

#: packages/core/src/presentation.ts:230
msgid "{degrees}° E"
msgstr "{degrees}° Ø"

#: packages/core/src/presentation.ts:230
msgid "{degrees}° W"
msgstr "{degrees}° V"

#. Translators: a Civil time on the day before today, e.g. "yesterday at 21:58".
#: packages/core/src/presentation.ts:251
msgid "yesterday at {time}"
msgstr "i går kl. {time}"

#. Translators: a Civil time on the day after today, e.g. "tomorrow at 05:47".
#: packages/core/src/presentation.ts:254
msgid "tomorrow at {time}"
msgstr "i morgen kl. {time}"

#. Translators: a Civil time further away than yesterday or tomorrow, e.g. "Thu 18 Jun at
#. 21:58"; {date} follows the locale of dates and times.
#: packages/core/src/presentation.ts:264
msgid "{date} at {time}"
msgstr "{date} kl. {time}"

#. Translators: a duration over 24 hours, e.g. "68d 23h", for a Polar day or Polar night.
#: packages/core/src/presentation.ts:285
msgid "{days}d {hours}h"
msgstr "{days} d {hours} t"

#. Translators: a duration under one hour, e.g. "42 min".
#: packages/core/src/presentation.ts:292
msgid "{minutes} min"
msgstr "{minutes} min"

#. Translators: a duration over one hour, e.g. "3h 05m"; {minutes} always has two digits.
#: packages/core/src/presentation.ts:295
msgid "{hours}h {minutes}m"
msgstr "{hours} t {minutes} min"

#. Translators: how much longer or shorter a Day is than the Day before, under a
#. minute, after an arrow: e.g. "↑45s".
#: packages/core/src/presentation.ts:315
msgid "{seconds}s"
msgstr "{seconds} s"

#. Translators: how much longer or shorter a Day is than the Day before, after an
#. arrow: e.g. "↓3m".
#: packages/core/src/presentation.ts:318
msgid "{minutes}m"
msgstr "{minutes} min"

#: packages/gnome-extension/src/extension.ts:91
