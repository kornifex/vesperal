#. Translators: a notification, e.g. "Sunset in 30 min".
#: packages/core/src/presentation.ts:151
msgid "{event} in {duration}"
msgstr "{event} d’aquí a {duration}"

#. Translators: a notification at the moment of an event, e.g. "Sunset now".
#: packages/core/src/presentation.ts:156
msgid "{event} now"
msgstr "{event} ara"

