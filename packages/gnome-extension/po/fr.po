#: packages/core/src/presentation.ts:88
msgid "Location unknown"
msgstr "Lieu inconnu"

#: packages/core/src/presentation.ts:89
msgid "Set a location manually…"
msgstr "Définir un lieu manuellement…"

#. Translators: shown in the top bar instead of the Reading when something went wrong.
#: packages/core/src/presentation.ts:97
msgid "Error"
msgstr "Erreur"

#: packages/core/src/presentation.ts:106
msgid "Polar day"
msgstr "Jour polaire"

#: packages/core/src/presentation.ts:106
msgid "Polar night"
msgstr "Nuit polaire"

#: packages/core/src/presentation.ts:118
msgid "Dawn"
msgstr "Aube"

#: packages/core/src/presentation.ts:119
msgid "Sunrise"
msgstr "Lever du soleil"

#: packages/core/src/presentation.ts:120
msgid "Sunset"
msgstr "Coucher du soleil"

#: packages/core/src/presentation.ts:121
msgid "Dusk"
msgstr "Crépuscule"

#: packages/core/src/presentation.ts:129 packages/core/src/presentation.ts:140
msgid "Day length"
msgstr "Durée du jour"

#: packages/core/src/presentation.ts:129
msgid "Night length"
msgstr "Durée de la nuit"

#: packages/core/src/presentation.ts:166
#: packages/gnome-extension/src/prefs.ts:60
msgid "Remaining time"
msgstr "Temps restant"

#: packages/core/src/presentation.ts:172
#: packages/gnome-extension/src/prefs.ts:61
msgid "Elapsed time"
msgstr "Temps écoulé"

#: packages/core/src/presentation.ts:189
msgid "Automatic location"
msgstr "Lieu automatique"

#: packages/core/src/presentation.ts:191
msgid "Manual location"
msgstr "Lieu manuel"

#: packages/core/src/presentation.ts:193
msgid "Last known location"
msgstr "Dernier lieu connu"

#: packages/core/src/presentation.ts:206
msgid "{degrees}° N"
msgstr "{degrees}° N"

#: packages/core/src/presentation.ts:206
msgid "{degrees}° S"
msgstr "{degrees}° S"

#: packages/core/src/presentation.ts:210
msgid "{degrees}° E"
msgstr "{degrees}° E"

#: packages/core/src/presentation.ts:210
msgid "{degrees}° W"
msgstr "{degrees}° O"

#. Translators: a Civil time on the day before today, e.g. "yesterday at 21:58".
#: packages/core/src/presentation.ts:231
msgid "yesterday at {time}"
msgstr "hier à {time}"

#. Translators: a Civil time on the day after today, e.g. "tomorrow at 05:47".
#: packages/core/src/presentation.ts:234
msgid "tomorrow at {time}"
msgstr "demain à {time}"

#. Translators: a Civil time further away than yesterday or tomorrow, e.g. "Thu 18 Jun at
#. 21:58"; {date} follows the locale of dates and times.
#: packages/core/src/presentation.ts:244
msgid "{date} at {time}"
msgstr "{date} à {time}"

#. Translators: a duration over 24 hours, e.g. "68d 23h", for a Polar day or Polar night.
#: packages/core/src/presentation.ts:265
msgid "{days}d {hours}h"
msgstr "{days} j {hours} h"

#. Translators: a duration under one hour, e.g. "42 min".
#: packages/core/src/presentation.ts:272
msgid "{minutes} min"
msgstr "{minutes} min"

#. Translators: a duration over one hour, e.g. "3h 05m"; {minutes} always has two digits.
#: packages/core/src/presentation.ts:275
msgid "{hours}h {minutes}m"
msgstr "{hours} h {minutes}"

#: packages/gnome-extension/src/extension.ts:44
msgid "Preferences"
msgstr "Préférences"

#: packages/gnome-extension/src/prefs.ts:50
msgid "Reading"
msgstr "Durée affichée"

#: packages/gnome-extension/src/prefs.ts:51
msgid "The duration shown in the top bar"
msgstr "Dans la barre supérieure"

#: packages/gnome-extension/src/prefs.ts:60
msgid "Until the next sunrise or sunset"
msgstr "Jusqu’au prochain lever ou coucher du soleil"

#: packages/gnome-extension/src/prefs.ts:61
msgid "Since the last sunrise or sunset"
msgstr "Depuis le dernier lever ou coucher du soleil"

#: packages/gnome-extension/src/prefs.ts:70
msgid "Sun arc"
msgstr "Arc solaire"

#: packages/gnome-extension/src/prefs.ts:71
msgid "Its side of the Reading in the top bar"
msgstr "De quel côté de la durée, dans la barre supérieure"

#: packages/gnome-extension/src/prefs.ts:85
msgid "Left"
msgstr "À gauche"

#: packages/gnome-extension/src/prefs.ts:86
msgid "Right"
msgstr "À droite"

#: packages/gnome-extension/src/prefs.ts:95
msgid "Twilight"
msgstr "Aube et crépuscule"

#: packages/gnome-extension/src/prefs.ts:96
msgid "When Dawn and Dusk fall, as shown in the menu"
msgstr "Leurs heures, affichées dans le menu"

#: packages/gnome-extension/src/prefs.ts:105
msgid "Civil"
msgstr "Civil"

#: packages/gnome-extension/src/prefs.ts:105
msgid "Sun 6° below the horizon"
msgstr "Soleil 6° sous l’horizon"

#: packages/gnome-extension/src/prefs.ts:106
msgid "Nautical"
msgstr "Nautique"

#: packages/gnome-extension/src/prefs.ts:106
msgid "Sun 12° below the horizon"
msgstr "Soleil 12° sous l’horizon"

#: packages/gnome-extension/src/prefs.ts:107
msgid "Astronomical"
msgstr "Astronomique"

#: packages/gnome-extension/src/prefs.ts:107
msgid "Sun 18° below the horizon"
msgstr "Soleil 18° sous l’horizon"

#: packages/gnome-extension/src/prefs.ts:123
msgid "Location"
msgstr "Lieu"

#: packages/gnome-extension/src/prefs.ts:135
msgid "Automatic"
msgstr "Automatique"

#: packages/gnome-extension/src/prefs.ts:136
msgid "Manual"
msgstr "Manuel"

#: packages/gnome-extension/src/prefs.ts:141
msgid "Search for a city"
msgstr "Rechercher une ville"

#: packages/gnome-extension/src/prefs.ts:152
msgid "Coordinates"
msgstr "Coordonnées"

#: packages/gnome-extension/src/prefs.ts:153
msgid "For any point on Earth, in decimal degrees"
msgstr "Pour n’importe quel point du globe, en degrés décimaux"

#: packages/gnome-extension/src/prefs.ts:157
msgid "Latitude (north positive)"
msgstr "Latitude (positive au nord)"

#: packages/gnome-extension/src/prefs.ts:162
msgid "Longitude (east positive)"
msgstr "Longitude (positive à l’est)"

#: packages/gnome-extension/src/prefs.ts:172
msgid "From the system's location services"
msgstr "Par les services de localisation du système"

#: packages/gnome-extension/src/prefs.ts:173
msgid "Location services are off"
msgstr "Les services de localisation sont désactivés"

#: packages/gnome-extension/src/prefs.ts:179
msgid "No location set"
msgstr "Aucun lieu défini"

#: packages/gnome-extension/src/prefs.ts:218
msgid "Latitude must be between −90 and 90"
msgstr "La latitude doit être comprise entre −90 et 90"

#: packages/gnome-extension/src/prefs.ts:221
msgid "Longitude must be between −180 and 180"
msgstr "La longitude doit être comprise entre −180 et 180"
