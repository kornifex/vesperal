#: packages/core/src/presentation.ts:86
msgid "Location unknown"
msgstr "Lieu inconnu"

#: packages/core/src/presentation.ts:87
msgid "Set a location manually…"
msgstr "Définir un lieu manuellement…"

#. Translators: shown in the top bar instead of the Reading when something went wrong.
#: packages/core/src/presentation.ts:95
msgid "Error"
msgstr "Erreur"

#: packages/core/src/presentation.ts:104
msgid "Polar day"
msgstr "Jour polaire"

#: packages/core/src/presentation.ts:104
msgid "Polar night"
msgstr "Nuit polaire"

#: packages/core/src/presentation.ts:116 packages/core/src/presentation.ts:120
msgid "Sunrise"
msgstr "Lever du soleil"

#: packages/core/src/presentation.ts:116 packages/core/src/presentation.ts:120
msgid "Sunset"
msgstr "Coucher du soleil"

#: packages/core/src/presentation.ts:124 packages/core/src/presentation.ts:135
msgid "Day length"
msgstr "Durée du jour"

#: packages/core/src/presentation.ts:124
msgid "Night length"
msgstr "Durée de la nuit"

#: packages/core/src/presentation.ts:167
#: packages/gnome-extension/src/prefs.ts:56
msgid "Remaining time"
msgstr "Temps restant"

#: packages/core/src/presentation.ts:169
#: packages/gnome-extension/src/prefs.ts:57
msgid "Elapsed time"
msgstr "Temps écoulé"

#: packages/core/src/presentation.ts:184
msgid "Automatic location"
msgstr "Lieu automatique"

#: packages/core/src/presentation.ts:186
msgid "Manual location"
msgstr "Lieu manuel"

#: packages/core/src/presentation.ts:188
msgid "Last known location"
msgstr "Dernier lieu connu"

#: packages/core/src/presentation.ts:201
msgid "{degrees}° N"
msgstr "{degrees}° N"

#: packages/core/src/presentation.ts:201
msgid "{degrees}° S"
msgstr "{degrees}° S"

#: packages/core/src/presentation.ts:205
msgid "{degrees}° E"
msgstr "{degrees}° E"

#: packages/core/src/presentation.ts:205
msgid "{degrees}° W"
msgstr "{degrees}° O"

#. Translators: a Civil time on the day before today, e.g. "yesterday at 21:58".
#: packages/core/src/presentation.ts:226
msgid "yesterday at {time}"
msgstr "hier à {time}"

#. Translators: a Civil time on the day after today, e.g. "tomorrow at 05:47".
#: packages/core/src/presentation.ts:229
msgid "tomorrow at {time}"
msgstr "demain à {time}"

#. Translators: a Civil time further away than yesterday or tomorrow, e.g. "Thu 18 Jun at
#. 21:58"; {date} follows the locale of dates and times.
#: packages/core/src/presentation.ts:239
msgid "{date} at {time}"
msgstr "{date} à {time}"

#. Translators: a duration over 24 hours, e.g. "68d 23h", for a Polar day or Polar night.
#: packages/core/src/presentation.ts:260
msgid "{days}d {hours}h"
msgstr "{days} j {hours} h"

#. Translators: a duration under one hour, e.g. "42 min".
#: packages/core/src/presentation.ts:267
msgid "{minutes} min"
msgstr "{minutes} min"

#. Translators: a duration over one hour, e.g. "3h 05m"; {minutes} always has two digits.
#: packages/core/src/presentation.ts:270
msgid "{hours}h {minutes}m"
msgstr "{hours} h {minutes}"

#: packages/gnome-extension/src/extension.ts:41
msgid "Preferences"
msgstr "Préférences"

#: packages/gnome-extension/src/prefs.ts:46
msgid "Reading"
msgstr "Durée affichée"

#: packages/gnome-extension/src/prefs.ts:47
msgid "The duration shown in the top bar"
msgstr "Dans la barre supérieure"

#: packages/gnome-extension/src/prefs.ts:56
msgid "Until the next sunrise or sunset"
msgstr "Jusqu’au prochain lever ou coucher du soleil"

#: packages/gnome-extension/src/prefs.ts:57
msgid "Since the last sunrise or sunset"
msgstr "Depuis le dernier lever ou coucher du soleil"

#: packages/gnome-extension/src/prefs.ts:66
msgid "Sun arc"
msgstr "Arc solaire"

#: packages/gnome-extension/src/prefs.ts:67
msgid "Its side of the Reading in the top bar"
msgstr "De quel côté de la durée, dans la barre supérieure"

#: packages/gnome-extension/src/prefs.ts:81
msgid "Left"
msgstr "À gauche"

#: packages/gnome-extension/src/prefs.ts:82
msgid "Right"
msgstr "À droite"

#: packages/gnome-extension/src/prefs.ts:98
msgid "Location"
msgstr "Lieu"

#: packages/gnome-extension/src/prefs.ts:110
msgid "Automatic"
msgstr "Automatique"

#: packages/gnome-extension/src/prefs.ts:111
msgid "Manual"
msgstr "Manuel"

#: packages/gnome-extension/src/prefs.ts:116
msgid "Search for a city"
msgstr "Rechercher une ville"

#: packages/gnome-extension/src/prefs.ts:127
msgid "Coordinates"
msgstr "Coordonnées"

#: packages/gnome-extension/src/prefs.ts:128
msgid "For any point on Earth, in decimal degrees"
msgstr "Pour n’importe quel point du globe, en degrés décimaux"

#: packages/gnome-extension/src/prefs.ts:132
msgid "Latitude (north positive)"
msgstr "Latitude (positive au nord)"

#: packages/gnome-extension/src/prefs.ts:137
msgid "Longitude (east positive)"
msgstr "Longitude (positive à l’est)"

#: packages/gnome-extension/src/prefs.ts:148
msgid "From the system's location services"
msgstr "Par les services de localisation du système"

#: packages/gnome-extension/src/prefs.ts:149
msgid "Location services are off"
msgstr "Les services de localisation sont désactivés"

#: packages/gnome-extension/src/prefs.ts:155
msgid "No location set"
msgstr "Aucun lieu défini"

#: packages/gnome-extension/src/prefs.ts:194
msgid "Latitude must be between −90 and 90"
msgstr "La latitude doit être comprise entre −90 et 90"

#: packages/gnome-extension/src/prefs.ts:197
msgid "Longitude must be between −180 and 180"
msgstr "La longitude doit être comprise entre −180 et 180"
