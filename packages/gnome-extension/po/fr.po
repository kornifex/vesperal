#: packages/core/src/presentation.ts:79 packages/core/src/presentation.ts:83
msgid "Sunrise"
msgstr "Lever du soleil"

#: packages/core/src/presentation.ts:79 packages/core/src/presentation.ts:83
msgid "Sunset"
msgstr "Coucher du soleil"

#: packages/core/src/presentation.ts:87 packages/core/src/presentation.ts:98
msgid "Day length"
msgstr "Durée du jour"

#: packages/core/src/presentation.ts:87
msgid "Night length"
msgstr "Durée de la nuit"

#: packages/core/src/presentation.ts:130
#: packages/gnome-extension/src/prefs.ts:23
msgid "Remaining time"
msgstr "Temps restant"

#: packages/core/src/presentation.ts:132
#: packages/gnome-extension/src/prefs.ts:24
msgid "Elapsed time"
msgstr "Temps écoulé"

#: packages/core/src/presentation.ts:140
msgid "Automatic location"
msgstr "Lieu automatique"

#: packages/core/src/presentation.ts:140
msgid "Manual location"
msgstr "Lieu manuel"

#: packages/core/src/presentation.ts:154
msgid "{degrees}° N"
msgstr "{degrees}° N"

#: packages/core/src/presentation.ts:154
msgid "{degrees}° S"
msgstr "{degrees}° S"

#: packages/core/src/presentation.ts:158
msgid "{degrees}° E"
msgstr "{degrees}° E"

#: packages/core/src/presentation.ts:158
msgid "{degrees}° W"
msgstr "{degrees}° O"

#. Translators: a Civil time on another day, e.g. "tomorrow at 05:47" or "Thu 18 Jun at 21:58".
#: packages/core/src/presentation.ts:183
msgid "{day} at {time}"
msgstr "{day} à {time}"

#. Translators: a duration under one hour, e.g. "42 min".
#: packages/core/src/presentation.ts:202
msgid "{minutes} min"
msgstr "{minutes} min"

#. Translators: a duration over one hour, e.g. "3h 05m"; {minutes} always has two digits.
#: packages/core/src/presentation.ts:205
msgid "{hours}h {minutes}m"
msgstr "{hours} h {minutes}"

#: packages/gnome-extension/src/extension.ts:21
msgid "Preferences"
msgstr "Préférences"

#: packages/gnome-extension/src/prefs.ts:17
msgid "Reading"
msgstr "Durée affichée"

#: packages/gnome-extension/src/prefs.ts:18
msgid "The duration shown in the top bar"
msgstr "Dans la barre supérieure"

#: packages/gnome-extension/src/prefs.ts:23
msgid "Until the next sunrise or sunset"
msgstr "Jusqu’au prochain lever ou coucher du soleil"

#: packages/gnome-extension/src/prefs.ts:24
msgid "Since the last sunrise or sunset"
msgstr "Depuis le dernier lever ou coucher du soleil"
