msgid "Left"
msgstr "Ліворуч"

#: packages/gnome-extension/src/prefs.ts:95
msgid "Right"
msgstr "Праворуч"

#: packages/gnome-extension/src/prefs.ts:104
msgid "Twilight"
msgstr "Світанок і смеркання"

#: packages/gnome-extension/src/prefs.ts:105
msgid "When Dawn and Dusk fall, as shown in the menu"
msgstr "Їхній час, показаний у меню"

#: packages/gnome-extension/src/prefs.ts:114
msgid "Civil"
msgstr "Громадянські"

#: packages/gnome-extension/src/prefs.ts:114
msgid "Sun 6° below the horizon"
msgstr "Сонце на 6° нижче горизонту"

#: packages/gnome-extension/src/prefs.ts:115
msgid "Nautical"
msgstr "Навігаційні"

#: packages/gnome-extension/src/prefs.ts:115
msgid "Sun 12° below the horizon"
msgstr "Сонце на 12° нижче горизонту"

#: packages/gnome-extension/src/prefs.ts:116
msgid "Astronomical"
msgstr "Астрономічні"

#: packages/gnome-extension/src/prefs.ts:116
msgid "Sun 18° below the horizon"
msgstr "Сонце на 18° нижче горизонту"

#: packages/gnome-extension/src/prefs.ts:144
msgid "Automatic"
msgstr "Автоматично"

#: packages/gnome-extension/src/prefs.ts:145
msgid "Manual"
msgstr "Вручну"

#: packages/gnome-extension/src/prefs.ts:150
msgid "Search for a city"
msgstr "Шукати місто"

#: packages/gnome-extension/src/prefs.ts:164
msgid "Coordinates"
msgstr "Координати"

#: packages/gnome-extension/src/prefs.ts:165
msgid "For any point on Earth, in decimal degrees"
msgstr "Для будь-якої точки Землі, у десяткових градусах"

