msgid "Latitude (north positive)"
msgstr "Широта (північ додатна)"

#: packages/gnome-extension/src/prefs.ts:174
msgid "Longitude (east positive)"
msgstr "Довгота (схід додатний)"

#: packages/gnome-extension/src/prefs.ts:184
msgid "From the system's location services"
msgstr "Зі служб визначення розташування системи"

#: packages/gnome-extension/src/prefs.ts:185
msgid "Location services are off"
msgstr "Служби визначення розташування вимкнено"

#: packages/gnome-extension/src/prefs.ts:191
msgid "No location set"
msgstr "Розташування не вказано"

#: packages/gnome-extension/src/prefs.ts:230
msgid "Latitude must be between −90 and 90"
msgstr "Широта має бути від −90 до 90"

#: packages/gnome-extension/src/prefs.ts:233
msgid "Longitude must be between −180 and 180"
msgstr "Довгота має бути від −180 до 180"
