#: packages/core/src/presentation.ts:218
msgid "{elapsed} / {remaining}"
msgstr "{elapsed} / {remaining}"

#: packages/core/src/presentation.ts:225
msgid "Polar day"
msgstr "Polardag"

#: packages/core/src/presentation.ts:227
msgid "Polar night"
msgstr "Polarnat"

#. Translators: shown in the top bar instead of the Reading while, counting from Dawn to
#. Dusk, the Sun does not get far enough below the horizon for Dusk for over 24 hours.
#: packages/core/src/presentation.ts:231
msgid "No dark night"
msgstr "Ingen mørk nat"

#: packages/core/src/presentation.ts:259 packages/core/src/presentation.ts:274
