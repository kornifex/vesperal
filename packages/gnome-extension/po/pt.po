#: packages/gnome-extension/src/prefs.ts:483
msgid "Location unknown"
msgstr "Localização desconhecida"

#: packages/core/src/presentation.ts:184
msgid "Set a location manually…"
msgstr "Definir uma localização manualmente…"

#. Translators: shown in the top bar instead of the Reading when something went wrong.
#: packages/core/src/presentation.ts:192
msgid "Error"
msgstr "Erro"

#. Translators: both Readings in the top bar, e.g. "6h 10m / 7h 50m"; the Elapsed time
#. first, as on a video player.
#: packages/core/src/presentation.ts:218
msgid "{elapsed} / {remaining}"
msgstr "{elapsed} / {remaining}"

#: packages/core/src/presentation.ts:225
msgid "Polar day"
msgstr "Dia polar"

#: packages/core/src/presentation.ts:227
msgid "Polar night"
msgstr "Noite polar"

#. Translators: shown in the top bar instead of the Reading while, counting from Dawn to
#. Dusk, the Sun does not get far enough below the horizon for Dusk for over 24 hours.
#: packages/core/src/presentation.ts:231
msgid "No dark night"
msgstr "Sem noite escura"

#: packages/core/src/presentation.ts:259 packages/core/src/presentation.ts:274
#: packages/core/src/yearPresentation.ts:55
msgid "Day length"
