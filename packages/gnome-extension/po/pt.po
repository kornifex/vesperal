#. Translators: a notification, e.g. "Sunset in 30 min".
#: packages/core/src/presentation.ts:160
msgid "{event} in {duration}"
msgstr "{event} daqui a {duration}"

#. Translators: a notification at the moment of an event, e.g. "Sunset now".
#: packages/core/src/presentation.ts:165
msgid "{event} now"
msgstr "{event} agora"

#: packages/core/src/presentation.ts:173
msgid "Dawn"
msgstr "Aurora"

