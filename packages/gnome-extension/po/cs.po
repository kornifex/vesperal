#: packages/core/src/presentation.ts:362
msgid "{degrees}° S"
msgstr "{degrees}° j. š."

#: packages/core/src/presentation.ts:366
msgid "{degrees}° E"
msgstr "{degrees}° v. d."

#: packages/core/src/presentation.ts:366
msgid "{degrees}° W"
msgstr "{degrees}° z. d."

#. Translators: a Civil time on the day before today, e.g. "yesterday at 21:58".
#: packages/core/src/presentation.ts:395
msgid "yesterday at {time}"
msgstr "včera v {time}"

#. Translators: a Civil time on the day after today, e.g. "tomorrow at 05:47".
#: packages/core/src/presentation.ts:398
msgid "tomorrow at {time}"
msgstr "zítra v {time}"

#. Translators: a Civil time further away than yesterday or tomorrow, e.g. "Thu 18 Jun at
#. 21:58"; {date} follows the locale of dates and times.
#: packages/core/src/presentation.ts:408
msgid "{date} at {time}"
msgstr "{date} v {time}"

#. Translators: a duration over 24 hours, e.g. "68d 23h", for a Polar day or Polar night.
#: packages/core/src/presentation.ts:416
msgid "{days}d {hours}h"
msgstr "{days} d {hours} h"

#. Translators: a duration under one hour, e.g. "42 min".
#: packages/core/src/presentation.ts:423
msgid "{minutes} min"
msgstr "{minutes} min"

#. Translators: a duration over one hour, e.g. "3h 05m"; {minutes} always has two digits.
#: packages/core/src/presentation.ts:426
msgid "{hours}h {minutes}m"
msgstr "{hours} h {minutes} min"

#. Translators: how much longer or shorter a Day is than the Day before, under a
#. minute, after an arrow: e.g. "↑45s".
#: packages/core/src/presentation.ts:457
msgid "{seconds}s"
msgstr "{seconds} s"

#. Translators: how much longer or shorter a Day is than the Day before, after an
#. arrow: e.g. "↓3m".
#: packages/core/src/presentation.ts:460
msgid "{minutes}m"
msgstr "{minutes} min"

#: packages/core/src/yearPresentation.ts:100
msgid "today"
msgstr "dnes"

#: packages/core/src/yearPresentation.ts:102
msgid "tomorrow"
msgstr "zítra"

#. Translators: how far away a date is, in days; never fewer than 2.
#: packages/core/src/yearPresentation.ts:104
msgid "in {days} day"
msgid_plural "in {days} days"
msgstr[0] "za {days} den"
msgstr[1] "za {days} dny"
msgstr[2] "za {days} dní"

#. Translators: a date to come, then how far away it is, e.g. "Monday 21 December, in 65 days";
#. {date} follows the locale of dates and times.
#: packages/core/src/yearPresentation.ts:107
msgid "{date}, {relative}"
msgstr "{date}, {relative}"

