#: packages/core/src/presentation.ts:98
msgid "Location unknown"
msgstr "Άγνωστη τοποθεσία"

#: packages/core/src/presentation.ts:99
msgid "Set a location manually…"
msgstr "Ορισμός τοποθεσίας χειροκίνητα…"

#. Translators: shown in the top bar instead of the Reading when something went wrong.
#: packages/core/src/presentation.ts:107
msgid "Error"
msgstr "Σφάλμα"

#: packages/core/src/presentation.ts:116
msgid "Polar day"
msgstr "Πολική ημέρα"

#: packages/core/src/presentation.ts:116
msgid "Polar night"
msgstr "Πολική νύχτα"

#: packages/core/src/presentation.ts:128
msgid "Dawn"
msgstr "Αυγή"

#: packages/core/src/presentation.ts:129
msgid "Sunrise"
msgstr "Ανατολή ηλίου"

#: packages/core/src/presentation.ts:130
msgid "Sunset"
msgstr "Δύση ηλίου"

#: packages/core/src/presentation.ts:131
msgid "Dusk"
msgstr "Σούρουπο"

#: packages/core/src/presentation.ts:139 packages/core/src/presentation.ts:150
msgid "Day length"
msgstr "Διάρκεια ημέρας"

#: packages/core/src/presentation.ts:139
msgid "Night length"
msgstr "Διάρκεια νύχτας"

#: packages/core/src/presentation.ts:176
#: packages/gnome-extension/src/prefs.ts:82
msgid "Remaining time"
msgstr "Υπολειπόμενος χρόνος"

#: packages/core/src/presentation.ts:182
#: packages/gnome-extension/src/prefs.ts:83
msgid "Elapsed time"
msgstr "Χρόνος που πέρασε"

#: packages/core/src/presentation.ts:199
msgid "Automatic location"
msgstr "Αυτόματη τοποθεσία"

#: packages/core/src/presentation.ts:201
msgid "Manual location"
msgstr "Χειροκίνητη τοποθεσία"

#: packages/core/src/presentation.ts:203
msgid "Last known location"
msgstr "Τελευταία γνωστή τοποθεσία"

#: packages/core/src/presentation.ts:216
msgid "{degrees}° N"
msgstr "{degrees}° Β"

#: packages/core/src/presentation.ts:216
msgid "{degrees}° S"
msgstr "{degrees}° Ν"

#: packages/core/src/presentation.ts:220
msgid "{degrees}° E"
msgstr "{degrees}° Α"

#: packages/core/src/presentation.ts:220
msgid "{degrees}° W"
msgstr "{degrees}° Δ"

#. Translators: a Civil time on the day before today, e.g. "yesterday at 21:58".
#: packages/core/src/presentation.ts:241
msgid "yesterday at {time}"
msgstr "χθες στις {time}"

#. Translators: a Civil time on the day after today, e.g. "tomorrow at 05:47".
#: packages/core/src/presentation.ts:244
msgid "tomorrow at {time}"
msgstr "αύριο στις {time}"

#. Translators: a Civil time further away than yesterday or tomorrow, e.g. "Thu 18 Jun at
#. 21:58"; {date} follows the locale of dates and times.
#: packages/core/src/presentation.ts:254
msgid "{date} at {time}"
msgstr "{date} στις {time}"

#. Translators: a duration over 24 hours, e.g. "68d 23h", for a Polar day or Polar night.
#: packages/core/src/presentation.ts:275
msgid "{days}d {hours}h"
msgstr "{days} ημ. {hours} ώ."

#. Translators: a duration under one hour, e.g. "42 min".
#: packages/core/src/presentation.ts:282
msgid "{minutes} min"
msgstr "{minutes} λεπ."

#. Translators: a duration over one hour, e.g. "3h 05m"; {minutes} always has two digits.
#: packages/core/src/presentation.ts:285
msgid "{hours}h {minutes}m"
msgstr "{hours} ώ. {minutes} λεπ."

#: packages/gnome-extension/src/extension.ts:91
msgid "Preferences"
msgstr "Προτιμήσεις"

#. Translators: a page of the preferences, about what the top bar and the menu show.
#: packages/gnome-extension/src/prefs.ts:44
msgid "Display"
msgstr "Εμφάνιση"

#: packages/gnome-extension/src/prefs.ts:48
#: packages/gnome-extension/src/prefs.ts:204
msgid "Location"
msgstr "Τοποθεσία"

#: packages/gnome-extension/src/prefs.ts:72
msgid "Reading"
msgstr "Εμφανιζόμενη διάρκεια"

#: packages/gnome-extension/src/prefs.ts:73
msgid "The duration shown in the top bar"
msgstr "Στην πάνω μπάρα"

#: packages/gnome-extension/src/prefs.ts:82
msgid "Until the next sunrise or sunset"
msgstr "Μέχρι την επόμενη ανατολή ή δύση του ηλίου"

#: packages/gnome-extension/src/prefs.ts:83
msgid "Since the last sunrise or sunset"
msgstr "Από την τελευταία ανατολή ή δύση του ηλίου"

#: packages/gnome-extension/src/prefs.ts:92
msgid "Content"
msgstr "Περιεχόμενο"

#: packages/gnome-extension/src/prefs.ts:93
msgid "What the top bar shows"
msgstr "Τι δείχνει η πάνω μπάρα"

#: packages/gnome-extension/src/prefs.ts:102
msgid "Sun arc and duration"
msgstr "Τόξο του ήλιου και διάρκεια"

#: packages/gnome-extension/src/prefs.ts:103
msgid "Sun arc only"
msgstr "Μόνο τόξο του ήλιου"

#: packages/gnome-extension/src/prefs.ts:104
msgid "Duration only"
msgstr "Μόνο διάρκεια"

#: packages/gnome-extension/src/prefs.ts:116
msgid "Sun arc"
msgstr "Τόξο του ήλιου"

#: packages/gnome-extension/src/prefs.ts:117
msgid "Its side of the Reading in the top bar"
msgstr "Σε ποια πλευρά της διάρκειας, στην πάνω μπάρα"

#: packages/gnome-extension/src/prefs.ts:136
msgid "Left"
msgstr "Αριστερά"

#: packages/gnome-extension/src/prefs.ts:137
msgid "Right"
msgstr "Δεξιά"

#. Translators: where the indicator sits in the top bar, not a geographic position.
#: packages/gnome-extension/src/prefs.ts:150
msgid "Position"
msgstr "Θέση"

#: packages/gnome-extension/src/prefs.ts:151
msgid "Where the indicator sits in the top bar"
msgstr "Πού βρίσκεται η ένδειξη στην πάνω μπάρα"

#: packages/gnome-extension/src/prefs.ts:165
msgid "Next to the clock"
msgstr "Δίπλα στο ρολόι"

#: packages/gnome-extension/src/prefs.ts:166
msgid "After the workspace indicator"
msgstr "Μετά την ένδειξη χώρων εργασίας"

#: packages/gnome-extension/src/prefs.ts:166
msgid "Left side"
msgstr "Αριστερή πλευρά"

#: packages/gnome-extension/src/prefs.ts:167
msgid "Before the system indicators"
msgstr "Πριν από τις ενδείξεις συστήματος"

#: packages/gnome-extension/src/prefs.ts:167
msgid "Right side"
msgstr "Δεξιά πλευρά"

#: packages/gnome-extension/src/prefs.ts:176
msgid "Twilight"
msgstr "Αυγή και σούρουπο"

#: packages/gnome-extension/src/prefs.ts:177
msgid "When Dawn and Dusk fall, as shown in the menu"
msgstr "Οι ώρες τους, όπως εμφανίζονται στο μενού"

#: packages/gnome-extension/src/prefs.ts:186
msgid "Civil"
msgstr "Πολιτικό"

#: packages/gnome-extension/src/prefs.ts:186
msgid "Sun 6° below the horizon"
msgstr "Ήλιος 6° κάτω από τον ορίζοντα"

#: packages/gnome-extension/src/prefs.ts:187
msgid "Nautical"
msgstr "Ναυτικό"

#: packages/gnome-extension/src/prefs.ts:187
msgid "Sun 12° below the horizon"
msgstr "Ήλιος 12° κάτω από τον ορίζοντα"

#: packages/gnome-extension/src/prefs.ts:188
msgid "Astronomical"
msgstr "Αστρονομικό"

#: packages/gnome-extension/src/prefs.ts:188
msgid "Sun 18° below the horizon"
msgstr "Ήλιος 18° κάτω από τον ορίζοντα"

#: packages/gnome-extension/src/prefs.ts:216
msgid "Automatic"
msgstr "Αυτόματη"

#: packages/gnome-extension/src/prefs.ts:217
msgid "Manual"
msgstr "Χειροκίνητη"

#: packages/gnome-extension/src/prefs.ts:222
msgid "Search for a city"
msgstr "Αναζήτηση πόλης"

#: packages/gnome-extension/src/prefs.ts:236
msgid "Coordinates"
msgstr "Συντεταγμένες"

#: packages/gnome-extension/src/prefs.ts:237
msgid "For any point on Earth, in decimal degrees"
msgstr "Για οποιοδήποτε σημείο της Γης, σε δεκαδικές μοίρες"

#: packages/gnome-extension/src/prefs.ts:241
msgid "Latitude (north positive)"
msgstr "Γεωγραφικό πλάτος (θετικό προς βορρά)"

#: packages/gnome-extension/src/prefs.ts:246
msgid "Longitude (east positive)"
msgstr "Γεωγραφικό μήκος (θετικό προς ανατολή)"

#: packages/gnome-extension/src/prefs.ts:256
msgid "From the system's location services"
msgstr "Από τις υπηρεσίες τοποθεσίας του συστήματος"

#: packages/gnome-extension/src/prefs.ts:257
msgid "Location services are off"
msgstr "Οι υπηρεσίες τοποθεσίας είναι απενεργοποιημένες"

#: packages/gnome-extension/src/prefs.ts:263
msgid "No location set"
msgstr "Δεν έχει οριστεί τοποθεσία"

#: packages/gnome-extension/src/prefs.ts:302
msgid "Latitude must be between −90 and 90"
msgstr "Το γεωγραφικό πλάτος πρέπει να είναι μεταξύ −90 και 90"

#: packages/gnome-extension/src/prefs.ts:305
msgid "Longitude must be between −180 and 180"
msgstr "Το γεωγραφικό μήκος πρέπει να είναι μεταξύ −180 και 180"
