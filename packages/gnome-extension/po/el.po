msgstr "Εμφανιζόμενη διάρκεια"

#: packages/gnome-extension/src/prefs.ts:100
msgid "The duration shown in the top bar"
msgstr "Στην πάνω μπάρα"

#: packages/gnome-extension/src/prefs.ts:111
msgid "Elapsed and remaining time"
msgstr "Χρόνος που πέρασε και που απομένει"

