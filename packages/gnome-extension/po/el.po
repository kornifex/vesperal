#: packages/core/src/presentation.ts:112
msgid "Set a location manually…"
msgstr "Ορισμός τοποθεσίας χειροκίνητα…"

#. Translators: shown in the top bar instead of the Reading when something went wrong.
#: packages/core/src/presentation.ts:120
msgid "Error"
msgstr "Σφάλμα"

#: packages/core/src/presentation.ts:129
msgid "Polar day"
msgstr "Πολική ημέρα"

#: packages/core/src/presentation.ts:129
msgid "Polar night"
msgstr "Πολική νύχτα"

#: packages/core/src/presentation.ts:141
msgid "Dawn"
msgstr "Αυγή"

#: packages/core/src/presentation.ts:142
msgid "Sunrise"
msgstr "Ανατολή ηλίου"

#: packages/core/src/presentation.ts:143
msgid "Sunset"
msgstr "Δύση ηλίου"

#: packages/core/src/presentation.ts:144
msgid "Dusk"
msgstr "Σούρουπο"

#: packages/core/src/presentation.ts:152 packages/core/src/presentation.ts:164
#: packages/core/src/yearPresentation.ts:59
msgid "Day length"
msgstr "Διάρκεια ημέρας"

#: packages/core/src/presentation.ts:152
msgid "Night length"
msgstr "Διάρκεια νύχτας"

#: packages/core/src/presentation.ts:190
#: packages/gnome-extension/src/prefs.ts:97
msgid "Remaining time"
msgstr "Υπολειπόμενος χρόνος"

#: packages/core/src/presentation.ts:196
#: packages/gnome-extension/src/prefs.ts:98
msgid "Elapsed time"
msgstr "Χρόνος που πέρασε"

#: packages/core/src/presentation.ts:213
msgid "Automatic location"
msgstr "Αυτόματη τοποθεσία"

#: packages/core/src/presentation.ts:215
msgid "Manual location"
msgstr "Χειροκίνητη τοποθεσία"

#: packages/core/src/presentation.ts:217
msgid "Last known location"
msgstr "Τελευταία γνωστή τοποθεσία"

#: packages/core/src/presentation.ts:230
msgid "{degrees}° N"
msgstr "{degrees}° Β"

#: packages/core/src/presentation.ts:230
msgid "{degrees}° S"
msgstr "{degrees}° Ν"

#: packages/core/src/presentation.ts:234
msgid "{degrees}° E"
msgstr "{degrees}° Α"

#: packages/core/src/presentation.ts:234
msgid "{degrees}° W"
msgstr "{degrees}° Δ"

#. Translators: a Civil time on the day before today, e.g. "yesterday at 21:58".
#: packages/core/src/presentation.ts:255
msgid "yesterday at {time}"
msgstr "χθες στις {time}"

#. Translators: a Civil time on the day after today, e.g. "tomorrow at 05:47".
#: packages/core/src/presentation.ts:258
msgid "tomorrow at {time}"
msgstr "αύριο στις {time}"

#. Translators: a Civil time further away than yesterday or tomorrow, e.g. "Thu 18 Jun at
#. 21:58"; {date} follows the locale of dates and times.
#: packages/core/src/presentation.ts:268
msgid "{date} at {time}"
msgstr "{date} στις {time}"

#. Translators: a duration over 24 hours, e.g. "68d 23h", for a Polar day or Polar night.
#: packages/core/src/presentation.ts:276
msgid "{days}d {hours}h"
msgstr "{days} ημ. {hours} ώ."

#. Translators: a duration under one hour, e.g. "42 min".
#: packages/core/src/presentation.ts:283
msgid "{minutes} min"
msgstr "{minutes} λεπ."

#. Translators: a duration over one hour, e.g. "3h 05m"; {minutes} always has two digits.
#: packages/core/src/presentation.ts:286
msgid "{hours}h {minutes}m"
msgstr "{hours} ώ. {minutes} λεπ."

#. Translators: how much longer or shorter a Day is than the Day before, under a
#. minute, after an arrow: e.g. "↑45s".
#: packages/core/src/presentation.ts:321
msgid "{seconds}s"
msgstr "{seconds} δευτ."

#. Translators: how much longer or shorter a Day is than the Day before, after an
#. arrow: e.g. "↓3m".
#: packages/core/src/presentation.ts:324
msgid "{minutes}m"
msgstr "{minutes} λεπ."

#: packages/core/src/yearPresentation.ts:105
msgid "today"
msgstr "σήμερα"

#: packages/core/src/yearPresentation.ts:107
msgid "tomorrow"
msgstr "αύριο"

#. Translators: how far away a date is, in days; never fewer than 2.
#: packages/core/src/yearPresentation.ts:109
msgid "in {days} day"
msgid_plural "in {days} days"
msgstr[0] "σε {days} ημέρα"
msgstr[1] "σε {days} ημέρες"

#. Translators: a date to come, then how far away it is, e.g. "Monday 21 December, in 65 days";
#. {date} follows the locale of dates and times.
#: packages/core/src/yearPresentation.ts:112
msgid "{date}, {relative}"
msgstr "{date}, {relative}"

#: packages/core/src/yearPresentation.ts:119
msgid "March equinox"
msgstr "Ισημερία Μαρτίου"

#: packages/core/src/yearPresentation.ts:121
msgid "June solstice"
msgstr "Ηλιοστάσιο Ιουνίου"

#: packages/core/src/yearPresentation.ts:123
msgid "September equinox"
msgstr "Ισημερία Σεπτεμβρίου"

#: packages/core/src/yearPresentation.ts:125
msgid "December solstice"
msgstr "Ηλιοστάσιο Δεκεμβρίου"

#: packages/gnome-extension/src/extension.ts:91
