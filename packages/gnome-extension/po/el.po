msgid "Since the last dawn or dusk"
msgstr "Από την τελευταία αυγή ή το τελευταίο σούρουπο"

#: packages/gnome-extension/src/prefs.ts:127
msgid "Since the last sunrise or sunset"
msgstr "Από την τελευταία ανατολή ή δύση του ηλίου"

#: packages/gnome-extension/src/prefs.ts:131
msgid "Since the last dawn or dusk, and until the next"
msgstr "Από την τελευταία αυγή ή το τελευταίο σούρουπο και μέχρι την επόμενη αυγή ή το επόμενο σούρουπο"

