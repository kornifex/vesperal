#: packages/gnome-extension/src/prefs.ts:181
msgid "Left side"
msgstr "Αριστερή πλευρά"

#: packages/gnome-extension/src/prefs.ts:182
msgid "Before the system indicators"
msgstr "Πριν από τις ενδείξεις συστήματος"

#: packages/gnome-extension/src/prefs.ts:182
msgid "Right side"
msgstr "Δεξιά πλευρά"

#: packages/gnome-extension/src/prefs.ts:191
msgid "Twilight"
msgstr "Αυγή και σούρουπο"

#: packages/gnome-extension/src/prefs.ts:192
msgid "When Dawn and Dusk fall, as shown in the menu"
msgstr "Οι ώρες τους, όπως εμφανίζονται στο μενού"

#: packages/gnome-extension/src/prefs.ts:201
msgid "Civil"
msgstr "Πολιτικό"

#: packages/gnome-extension/src/prefs.ts:201
