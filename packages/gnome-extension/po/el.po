msgstr "Ήλιος 6° κάτω από τον ορίζοντα"

#: packages/gnome-extension/src/prefs.ts:202
msgid "Nautical"
msgstr "Ναυτικό"

#: packages/gnome-extension/src/prefs.ts:202
msgid "Sun 12° below the horizon"
msgstr "Ήλιος 12° κάτω από τον ορίζοντα"

#: packages/gnome-extension/src/prefs.ts:203
msgid "Astronomical"
msgstr "Αστρονομικό"

#: packages/gnome-extension/src/prefs.ts:203
msgid "Sun 18° below the horizon"
msgstr "Ήλιος 18° κάτω από τον ορίζοντα"

#: packages/gnome-extension/src/prefs.ts:232
msgid "Automatic"
msgstr "Αυτόματη"

#: packages/gnome-extension/src/prefs.ts:233
msgid "Manual"
msgstr "Χειροκίνητη"

#: packages/gnome-extension/src/prefs.ts:238
